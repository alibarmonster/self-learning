# Copy to .env.local (git-ignored) to turn on accounts in `bun run dev`.
# The same names go into Vercel → Settings → Environment Variables for production.

# The owner account — always an admin. Its password lives only here.
# Pick your own; use a long password.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional: signs session cookies instead of the owner's credentials.
SESSION_SECRET=

# The database. Leave empty locally to use data/exam-prep.db (a plain SQLite file).
# In production: the Turso database URL and token (turso db show --url / turso db tokens create).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
